    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model CreateAccountViewModel
@{
    ViewData["Title"] = "Account Page";
}

<div>
    <h1>Maak een account aan</h1>
    <form asp-controller="Account" asp-action="CreateAccount" method="post">
        <div class="form-actions create-menu">
            <div class="label">
                <label>Vul hier je voornaam in:</label>
                <input asp-for="Voornaam" />
            </div>
            <div class="label"> 
                <label>Vul hier je achternaam in:</label>
                <input asp-for="Achternaam"/>
            </div>
            <div class="label">
                <label>Vul hier je adres in:</label>
                <input asp-for="Adres"/>
            </div>
            <div class="label">
                <label>Vul hier je huisnummer in:</label>
                <input asp-for="Huisnummer"/>
            </div>
            <div class="label">
                <label>Vul hier je postcode in:</label>
                <input asp-for="Postcode"/>
            </div>
            <div class="label">
                <label>Vul hier je gemeente in:</label>
                <input asp-for="Gemeente"/>
            </div>
            <div class="label">
                <label>Vul hier je email in:</label>
                <input asp-for="Email"/>
            </div>
            <div class="label">
                <label>Vul hier je wachtwoord in:</label>
                <input asp-for="Wachtwoord"/>
            </div>
            <div class="form-group">
                <label asp-for="BevestigWachtwoord">Bevestig wachtwoord</label>
                <input asp-for="BevestigWachtwoord"
                       type="password"
                       class="form-control"
                       placeholder="Herhaal je wachtwoord" />
                <span asp-validation-for="BevestigWachtwoord"
                      class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LandId" class="control-label"></label>
                <select asp-for="LandId" asp-items="Model.Landen" class="form-control">
                    <option value="">-- Selecteer Land --</option>
                </select>
                <span asp-validation-for="LandId" class="text-danger"></span>
            </div>

            <button type="submit">Create</button>
        </div>
    </form>
</div>
