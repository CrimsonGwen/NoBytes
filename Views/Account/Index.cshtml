@model CreateAccountViewModel

@{
    ViewData["Title"] = "Account Page";
}

<dialog id="errorModal" data-show-errors="@(!ViewData.ModelState.IsValid)" class="p-4 rounded shadow border bg-white border-secondary">
    <div class="vstack gap-3">
        <h3 class="h5 text-danger fw-bold">Oeps, er ging iets mis!</h3>
        <div asp-validation-summary="All" class="text-danger small"></div>
        <div class="d-flex justify-content-end">
            <button type="button" id="closeModalBtn" class="btn btn-secondary btn-sm">Sluiten</button>
        </div>
    </div>
</dialog>

<dialog id="confirmModal" class="p-4 rounded shadow border bg-white border-secondary">
    <div class="vstack gap-3" style="min-width: 300px;">
        <h3 class="h5 fw-bold text-primary">Controleer je gegevens</h3>
        <p class="small text-muted mb-0">Zijn deze gegevens correct?</p>

        <ul class="list-unstyled small mb-3">
            <li><strong>Naam:</strong> <span id="confVoornaam"></span> <span id="confAchternaam"></span></li>
            <li><strong>Gebruikersnaam:</strong> <span id="confGebruikersnaam"></span></li>
            <li><strong>Email:</strong> <span id="confEmail"></span></li>
            <li><strong>Adres:</strong> <span id="confAdres"></span> <span id="confHuisnummer"></span>, <span id="confPostcode"></span> <span id="confGemeente"></span></li>
        </ul>

        <div class="d-flex justify-content-end gap-2">
            <button type="button" id="cancelModalBtn" class="btn btn-secondary btn-sm">Nee, wijzigen</button>
            <button type="button" id="confirmSubmitBtn" class="btn btn-primary btn-sm">Ja, verzenden</button>
        </div>
    </div>
</dialog>

<div>
    <h1>Maak een account aan</h1>

    <form asp-controller="Account" asp-action="CreateAccount" method="post" id="registerForm">
        <div class="create-menu">

            <div class="gegevens">
                <div class="form-row">
                    <div class="label">
                        <label>Voornaam</label>
                        <input asp-for="Voornaam" class="form-control" />
                    </div>
                    <div class="label">
                        <label>Achternaam</label>
                        <input asp-for="Achternaam" class="form-control" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="label">
                        <label>Gebruikersnaam</label>
                        <input asp-for="Gebruikersnaam" class="form-control" />
                    </div>
                    <div class="label">
                        <label>Email</label>
                        <input asp-for="Email" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="adres">
                <div class="form-row">
                    <div class="label">
                        <label>Adres</label>
                        <input asp-for="Adres" class="form-control" />
                    </div>
                    <div class="label">
                        <label>Huisnummer</label>
                        <input asp-for="Huisnummer" class="form-control" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="label">
                        <label>Postcode</label>
                        <input asp-for="Postcode" class="form-control" />
                    </div>
                    <div class="label">
                        <label>Gemeente</label>
                        <input asp-for="Gemeente" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="wachtwoord">
                <div class="password-row">
                    <div class="label">
                        <label>Eigen wachtwoord</label>
                        <input asp-for="Wachtwoord"
                               type="password"
                               id="wachtwoordInput"
                               class="form-control" />
                    </div>


                    <button type="button"
                            id="generateBtn"
                            class="btn btn-light text-dark btn-generate">
                        Genereer
                    </button>

                    <button type="button"
                            id="togglePasswordBtn"
                            class="btn btn-light text-dark">
                        Toon wachtwoord
                    </button>

                </div>
            </div>

            <div class="label">
                <label asp-for="LandId" class="control-label">Land</label>
            </div>

            <div class="form-group">
                <select asp-for="LandId"
                        asp-items="Model.Landen"
                        class="form-control">
                    <option value="">-- Selecteer Land --</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary mt-3">
                Create
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/errorModal.js" asp-append-version="true"></script>
    <script src="~/js/confirmationModal.js" asp-append-version="true"></script>
    <script src="~/js/passwordGenerator.js" asp-append-version="true"></script>
}
