    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model CreateAccountViewModel
@{
    ViewData["Title"] = "Account Page";
}

<div>
    <h1>Maak een account aan</h1>
    <form asp-controller="Account" asp-action="CreateAccount" method="post">
        <div class="form-actions create-menu">
            <div class="label">
                <label>Voornaam</label>
                <input asp-for="Voornaam" />
            </div>
            <div class="label"> 
                <label>Achternaam</label>
                <input asp-for="Achternaam"/>
            </div>
            <div class="label">
                <label>Adres</label>
                <input asp-for="Adres"/>
            </div>
            <div class="label">
                <label>Huisnummer</label>
                <input asp-for="Huisnummer"/>
            </div>
            <div class="label">
                <label>Postcode</label>
                <input asp-for="Postcode"/>
            </div>
            <div class="label">
                <label>Gemeente</label>
                <input asp-for="Gemeente"/>
            </div>
            <div class="label">
                <label>Email</label>
                <input asp-for="Email"/>
            </div>
            <div class="label">
                <label>Eigen wachtwoord</label>
                <input asp-for="Wachtwoord"/>
            </div>
            <div class="form-group">
                <label asp-for="LandId" class="control-label">Land</label>
                <select asp-for="LandId" asp-items="Model.Landen" class="form-control">
                    <option value="">-- Selecteer Land --</option>
                </select>
                <span asp-validation-for="LandId" class="text-danger"></span>
            </div>

            <button type="submit">Create</button>
        </div>
    </form>
</div>
