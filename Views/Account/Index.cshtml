    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model CreateAccountViewModel
@{
    ViewData["Title"] = "Account Page";
}

<dialog id="errorModal" data-show-errors="@(!ViewData.ModelState.IsValid)" class="p-4 rounded shadow border bg-white border-secondary">
    <div class="vstack gap-3">
        <h3 class="h5 text-danger fw-bold">Oeps, er ging iets mis!</h3>
        <div asp-validation-summary="All" class="text-danger small"></div>
        <div class="d-flex justify-content-end">
            <button type="button" id="closeModalBtn" class="btn btn-secondary btn-sm">Sluiten</button>
        </div>
    </div>
</dialog>

<div>
    <h1>Maak een account aan</h1>
    <form asp-controller="Account" asp-action="CreateAccount" method="post">
        <div class="create-menu">

            <div class="gegevens">
                <div class="form-row">
                    <div class="label">
                        <label>Voornaam</label>
                        <input asp-for="Voornaam" class="form-control" />
                    </div>
                    <div class="label">
                        <label>Achternaam</label>
                        <input asp-for="Achternaam" class="form-control" />
                    </div>
                </div>
                <div class="label">
                    <label>Email</label>
                    <input asp-for="Email" class="form-control" />
                </div>
            </div>

            <div class="adres">
                <div class="form-row">
                    <div class="label">
                        <label>Adres</label>
                        <input asp-for="Adres" class="form-control" />
                    </div>
                    <div class="label">
                        <label>Huisnummer</label>
                        <input asp-for="Huisnummer" class="form-control" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="label">
                        <label>Postcode</label>
                        <input asp-for="Postcode" class="form-control" />
                    </div>
                    <div class="label">
                        <label>Gemeente</label>
                        <input asp-for="Gemeente" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="wachtwoord">
                <div class="password-row">
                    <div class="label">
                        <label>Eigen wachtwoord</label>
                        <input asp-for="Wachtwoord" type="password" id="wachtwoordInput" class="form-control" />
                    </div>
                    <button type="button" id="generateBtn" class="btn btn-outline-secondary btn-generate">Genereer</button>
                </div>
            </div>

            <div class="label">
                <label asp-for="LandId" class="control-label">Land</label>
                <select asp-for="LandId" asp-items="Model.Landen" class="form-control">
                    <option value="">-- Selecteer Land --</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary mt-3">Create</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/errorModal.js" asp-append-version="true"></script>
}