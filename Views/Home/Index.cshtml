@{
    ViewData["Title"] = "Home Page";
    ViewData["HideNavbar"] = true;
}

<div class="split-hero-wrapper">
    <!-- Top Floating Logo & Title -->
    <div class="hero-header-overlay">
        <img src="/Pixelkok met dampende pizza.png" class="hero-brand-logo" alt="NoBytes Logo" />
        <h1 class="hero-brand-title">NoBytes</h1>
    </div>

    <!-- Left Panel (Login) -->
    <div class="split-pane pane-left">
        <div class="pane-content">
            <a class="luxury-btn" asp-area="" asp-controller="Account" asp-action="LogIn">Login</a>
        </div>
    </div>

    <!-- Right Panel (Create) -->
    <div class="split-pane pane-right">
        <div class="pane-content">
            <a class="luxury-btn" asp-controller="Account" asp-action="Index">Creër</a>
        </div>
    </div>
</div>