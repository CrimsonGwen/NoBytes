@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center hero-container">
        <div>
            <img src="/Pixelkok met dampende Pizza.png" class="hero-image"/>
        </div>
        <div class="text-background">
            <h1 class="display-4">Welkom bij Nobytes</h1>
            <h2 class="display-4">Waar er geen bytes overblijven</h2>
        </div>
        <div class="home-btn-group">
            <a class="home-btn-login" asp-area="" asp-controller="LogIn" asp-action="LogIn">Login</a>
            <a class="home-btn-create" asp-controller="Account" asp-action="Index">Creër</a>
        </div>
</div>
