@model Restaurant.ViewModels.ManageAccountViewModel

@{
    ViewData["Title"] = "Mijn account";
}

<div class="container mt-4">

    <h1>Mijn account</h1>

    <p class="text-muted">
        Bekijk en wijzig hier je persoonlijke gegevens.
    </p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h3 class="mb-4">Persoonlijke gegevens</h3>

            <form asp-controller="Klant"
                  asp-action="ManageAccount"
                  method="post">

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Voornaam"
                               class="form-label"></label>

                        <input asp-for="Voornaam"
                               class="form-control" />

                        <span asp-validation-for="Voornaam"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Achternaam"
                               class="form-label"></label>

                        <input asp-for="Achternaam"
                               class="form-control" />

                        <span asp-validation-for="Achternaam"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Gebruikersnaam"
                               class="form-label"></label>

                        <input asp-for="Gebruikersnaam"
                               class="form-control" />

                        <span asp-validation-for="Gebruikersnaam"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Email"
                               class="form-label"></label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control" />

                        <span asp-validation-for="Email"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-8 mb-3">
                        <label asp-for="Adres"
                               class="form-label"></label>

                        <input asp-for="Adres"
                               class="form-control" />

                        <span asp-validation-for="Adres"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Huisnummer"
                               class="form-label"></label>

                        <input asp-for="Huisnummer"
                               class="form-control" />

                        <span asp-validation-for="Huisnummer"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Postcode"
                               class="form-label"></label>

                        <input asp-for="Postcode"
                               class="form-control" />

                        <span asp-validation-for="Postcode"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-8 mb-3">
                        <label asp-for="Gemeente"
                               class="form-label"></label>

                        <input asp-for="Gemeente"
                               class="form-control" />

                        <span asp-validation-for="Gemeente"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-12 mb-3">
                        <label asp-for="LandId"
                               class="form-label"></label>

                        <select asp-for="LandId"
                                asp-items="Model.Landen"
                                class="form-select">

                            <option value="">
                                -- Selecteer Land --
                            </option>

                        </select>

                        <span asp-validation-for="LandId"
                              class="text-danger"></span>
                    </div>

                </div>

                <button type="submit" class="btn btn-primary">
                    Wijzigingen opslaan
                </button>

                <a asp-controller="Klant"
                   asp-action="Index"
                   class="btn btn-secondary">

                    Terug
                </a>

            </form>

        </div>
    </div>

    <div class="card border-danger mb-4">
        <div class="card-body">

            <h3 class="text-danger">Account verwijderen</h3>

            <p>
                Wanneer je jouw account verwijdert,
                worden je persoonlijke gegevens geanonimiseerd.
                Je kunt daarna niet meer inloggen.
            </p>

            <p class="fw-bold text-danger">
                Deze actie kan niet ongedaan worden gemaakt.
            </p>

            <form asp-controller="Klant"
                  asp-action="DeleteAccount"
                  method="post"
                  onsubmit="return confirm('Ben je zeker dat je jouw account definitief wilt verwijderen?');">

                <button type="submit" class="btn btn-danger">
                    Mijn account verwijderen
                </button>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}