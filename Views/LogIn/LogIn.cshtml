@model Restaurant.ViewModels.LogInVieuwModel;
@{
    ViewData["Title"] = "LogIn";
}

<dialog>

</dialog>

<div class ="text-center hero">
    <div class="text-background">
        <h1>Log in</h1> 

        <form asp-controller="LogIn" asp-action="Login" method="post">

            <div class="label">
                <label asp-for="Gebruikersnaam" class="form-label">Gebruikersnaam</label>
                <input asp-for="Gebruikersnaam" class="form-control" />
                <span asp-validation-for="Gebruikersnaam" class="text-danger"></span>
            </div>

            <div class="label">
                <label asp-for="Password" class="form-label">Wachtwoord</label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="label">
                <span asp-validation-summary="All"></span>
            </div>
            <button type="submit" class="home-btn">Inloggen</button>
        </form>

        @* <div class="home-btn-group">
            <a asp-area="" asp-controller="" asp-action="" class="home-btn">Inloggen</a>
        </div> *@

        <div>
            <p><a asp-area="" asp-controller="Gebruiker" asp-action="WachtwoordVergeten">Wachtwoord Vergeten?</a> </p>
        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial"/>
}
