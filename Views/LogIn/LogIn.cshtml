@model LogInVieuwModel;
@{
    ViewData["Title"] = "LogIn";
}

<div class ="text-center hero">
    <div class="text-background">
        <h1>Log in</h1>

        <form asp-action="Login" method="post">

            <div class="label">
                <label asp-for="Email" class="form-label">Gebruikersnaam</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="label">
                <label asp-for="Password" class="form-label">Wachtwoord</label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="label">
                <span asp-validation-summary="All"></span>
            </div>
            
        </form>

        <div class="home-btn-group">
            <button type="submit" asp-action="Index" class="home-btn">Inloggen</button>
        </div>

        
        <div>
            <p><a asp-area="" asp-controller="Gebruiker" asp-action="WachtwoordVergeten">Nog geen acount klik hier.</a> </p>
        </div>
    </div>

</div>
