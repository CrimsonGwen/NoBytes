@{
}
<div class="container">
    <div class="row g-4">
        @foreach (var product in Model)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100" style="width: 18rem;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@product.Naam</h5>

                       
                        <p class="card-text">
                            @product.Beschrijving
                        </p>

                        <p class="card-text">
                            <strong>Allergenen:</strong>
                            @product.AllergenenInfo
                        </p>
                        
                      @*   <p class="card-text">
                            <strong>Prijs:</strong>
                            € @product.PrijsProducten.ToString("0.00")
                        </p> *@

                        @* <button type="button" class="btn btn-lg btn-danger" data-bs-toggle="popover" data-bs-title="Allergenen" data-bs-content="@product.AllergenenInfo">Allergenen</button> *@

                        
                    </div>
                </div>
            </div>
        }
    </div>
</div>