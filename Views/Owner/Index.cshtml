@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
   ViewData["Title"] = "Owner Dashboard";
   var activeSection = ViewData["ActiveSection"] as string ?? "reservations";
}

<div class="dashboard-shell">
    <!-- Dashboard Header -->
    <div class="dashboard-topbar">
        <div>
            <p class="dashboard-eyebrow">Management Suite</p>
            <h1 class="dashboard-title">Owner Overview</h1>
        </div>
        <div class="dashboard-actions">
            <button type="button" class="luxury-btn luxury-btn--sm">+ New Reservation</button>
        </div>
    </div>

    <!-- Summary KPI Row -->
    <section class="kpi-grid" aria-label="Key metrics">
        <article class="kpi-card">
            <span class="kpi-label">Reservations Today</span>
            <strong class="kpi-value">28</strong>
            <span class="kpi-meta">4 pending confirmation</span>
        </article>
        <article class="kpi-card">
            <span class="kpi-label">Active Users</span>
            <strong class="kpi-value">142</strong>
            <span class="kpi-meta">6 staff roles</span>
        </article>
        <article class="kpi-card">
            <span class="kpi-label">Emails (Survey / News)</span>
            <strong class="kpi-value">19 / 3</strong>
            <span class="kpi-meta">Sent this week</span>
        </article>
        <article class="kpi-card">
            <span class="kpi-label">Overview Reports</span>
            <strong class="kpi-value">3 × 3</strong>
            <span class="kpi-meta">Types × Categories ready</span>
        </article>
    </section>

    <!-- Main Workspace: Navigation Rail + Active Module -->
    <div class="dashboard-body">
        <aside class="dashboard-nav" aria-label="Management sections">
            <button type="button" class="dash-nav-item @(activeSection == "reservations" ? "is-active" : "")" data-target="panel-reservations">
                Manage Reservations
            </button>
            <button type="button" class="dash-nav-item @(activeSection == "users" ? "is-active" : "")" data-target="panel-users">
                Manage Users
            </button>
            <button type="button" class="dash-nav-item @(activeSection == "emails" ? "is-active" : "")" data-target="panel-emails">
                Manage Emails
                <small>Questionnaire &amp; Newsletter</small>
            </button>
            <button type="button" class="dash-nav-item @(activeSection == "reports" ? "is-active" : "")" data-target="panel-reports">
                Create Overview
                <small>3 Report Types · 3 Categories</small>
            </button>
        </aside>

        <div class="dashboard-content">
            <!-- PRIMARY FOCUS: MANAGE RESERVATIONS -->
            <section id="panel-reservations" class="dash-panel is-visible">
                <div class="panel-header">
                    <div>
                        <h2>Manage Reservations</h2>
                        <p class="panel-subtitle">Review incoming bookings, assign seating, and update guest statuses.</p>
                    </div>
                    <div class="panel-filters">
                        <input type="date" class="dash-input" aria-label="Filter by date" />
                        <select class="dash-input" aria-label="Filter by status">
                            <option value="">All Statuses</option>
                            <option value="Confirmed">Confirmed</option>
                            <option value="Pending">Pending</option>
                            <option value="Seated">Seated</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Guest</th>
                                <th>Guests</th>
                                <th>Status</th>
                                <th>Notes</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>18:30</td>
                                <td><strong>Sander Peeters</strong><br /><span class="text-muted-soft">sander@example.be</span></td>
                                <td>4</td>
                                <td><span class="status-badge status-confirmed">Confirmed</span></td>
                                <td>Window table if possible</td>
                                <td class="text-end">
                                    <button type="button" class="dash-action-btn">Seat</button>
                                    <button type="button" class="dash-action-btn dash-action-btn--ghost">Edit</button>
                                </td>
                            </tr>
                            <tr>
                                <td>19:15</td>
                                <td><strong>Lotte Vermeulen</strong><br /><span class="text-muted-soft">lotte@example.be</span></td>
                                <td>2</td>
                                <td><span class="status-badge status-pending">Pending</span></td>
                                <td>Nut allergy noted</td>
                                <td class="text-end">
                                    <button type="button" class="dash-action-btn">Confirm</button>
                                    <button type="button" class="dash-action-btn dash-action-btn--ghost">Cancel</button>
                                </td>
                            </tr>
                            <tr>
                                <td>20:00</td>
                                <td><strong>Bram Jacobs</strong><br /><span class="text-muted-soft">bram@example.be</span></td>
                                <td>6</td>
                                <td><span class="status-badge status-seated">Seated</span></td>
                                <td>Anniversary dinner</td>
                                <td class="text-end">
                                    <button type="button" class="dash-action-btn dash-action-btn--ghost">Details</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- PLACEHOLDER PANELS FOR OTHER OWNER MODULES -->
            <section id="panel-users" class="dash-panel">
                <div class="panel-header">
                    <div>
                        <h2>Manage Users</h2>
                        <p class="panel-subtitle">Assign roles, manage staff access, and review registered accounts.</p>
                    </div>
                </div>
                <p class="panel-placeholder">User management table and role assignment controls plug in here.</p>
            </section>

            <section id="panel-emails" class="dash-panel">
                <div class="panel-header">
                    <div>
                        <h2>Manage Emails</h2>
                        <p class="panel-subtitle">Configure post-visit questionnaires and send newsletters.</p>
                    </div>
                </div>
                <div class="subcard-grid">
                    <div class="subcard">
                        <h3>Questionnaire Emails</h3>
                        <p>Automated feedback requests and response overview.</p>
                    </div>
                    <div class="subcard">
                        <h3>Newsletter</h3>
                        <p>Seasonal announcements, menus, and subscriber lists.</p>
                    </div>
                </div>
            </section>

            <section id="panel-reports" class="dash-panel">
                <div class="panel-header">
                    <div>
                        <h2>Create Overview</h2>
                        <p class="panel-subtitle">Generate overviews across 3 report types and 3 categories.</p>
                    </div>
                </div>
                <div class="subcard-grid">
                    <div class="subcard">
                        <h3>Report Types (3)</h3>
                        <p>Summary, Trend Comparison, and Detailed Breakdown.</p>
                    </div>
                    <div class="subcard">
                        <h3>Categories (3)</h3>
                        <p>Reservations, Users &amp; Roles, and Email Engagement.</p>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.dash-nav-item').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.dash-nav-item').forEach(b => b.classList.remove('is-active'));
                document.querySelectorAll('.dash-panel').forEach(p => p.classList.remove('is-visible'));

                btn.classList.add('is-active');
                const targetId = btn.getAttribute('data-target');
                const targetPanel = document.getElementById(targetId);
                if (targetPanel) {
                    targetPanel.classList.add('is-visible');
                }
            });
        });
    </script>
}
