@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@model IEnumerable<Restaurant.Models.Reservatie>
@{
    ViewData["Title"] = "Owner Dashboard";
    var activeSection = ViewData["ActiveSection"] as string ?? "reservations";
    var datumFilter = ViewBag.DatumFilter as string ?? "";
    var statusFilter = ViewBag.StatusFilter as string ?? "";
    var reservaties = Model ?? Enumerable.Empty<Restaurant.Models.Reservatie>();
}

<div class="dashboard-shell">
    <!-- Dashboard Header -->
    <div class="dashboard-topbar">
        <div>
            <p class="dashboard-eyebrow">Management Suite</p>
            <h1 class="dashboard-title">Owner Overview</h1>
        </div>
        <div class="dashboard-actions">
            <button type="button" class="luxury-btn luxury-btn--sm">+ New Reservation</button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div class="dash-alert dash-alert--success" role="status">
            @successMsg
        </div>
    }

    @if (TempData["WarningMessage"] is string warningMsg)
    {
        <div class="dash-alert dash-alert--warning" role="alert">
            @warningMsg
        </div>
    }

    <!-- Summary KPI Row -->
    <section class="kpi-grid" aria-label="Key metrics">
        <article class="kpi-card">
            <span class="kpi-label">Reservations Today</span>
            <strong class="kpi-value">@reservaties.Count(r => r.Datum.HasValue && r.Datum.Value.Date == DateTime.Today)</strong>
            <span class="kpi-meta">Today's bookings</span>
        </article>
        <article class="kpi-card">
            <span class="kpi-label">Checked In</span>
            <strong class="kpi-value">@reservaties.Count(r => r.IsAanwezig)</strong>
            <span class="kpi-meta">Currently present</span>
        </article>
        <article class="kpi-card">
            <span class="kpi-label">Emails (Survey / News)</span>
            <strong class="kpi-value">-</strong>
            <span class="kpi-meta">Managed in Emails tab</span>
        </article>
        <article class="kpi-card">
            <span class="kpi-label">Overview Reports</span>
            <strong class="kpi-value">3 × 3</strong>
            <span class="kpi-meta">Types × Categories ready</span>
        </article>
    </section>

    <!-- Main Workspace: Navigation Rail + Active Module -->
    <div class="dashboard-body">
        <aside class="dashboard-nav" aria-label="Management sections">
            <button type="button" class="dash-nav-item @(activeSection == "reservations" ? "is-active" : "")" data-target="panel-reservations">
                Manage Reservations
            </button>
            <button type="button" class="dash-nav-item @(activeSection == "users" ? "is-active" : "")" data-target="panel-users">
                Manage Users
            </button>
            <button type="button" class="dash-nav-item @(activeSection == "emails" ? "is-active" : "")" data-target="panel-emails">
                Manage Emails
                <small>Questionnaire &amp; Newsletter</small>
            </button>
            <button type="button" class="dash-nav-item @(activeSection == "reports" ? "is-active" : "")" data-target="panel-reports">
                Create Overview
                <small>3 Report Types · 3 Categories</small>
            </button>
        </aside>

        <div class="dashboard-content">
            <!-- PRIMARY FOCUS: MANAGE RESERVATIONS -->
            <section id="panel-reservations" class="dash-panel is-visible">
                <div class="panel-header">
                    <div>
                        <h2>Manage Reservations</h2>
                        <p class="panel-subtitle">Review incoming bookings, assign seating, and update guest statuses.</p>
                    </div>
                    <form asp-action="Index" method="get" class="panel-filters">
                        <input type="date" name="datumFilter" value="@datumFilter" class="dash-input" aria-label="Filter by date" />
                        <select name="statusFilter" class="dash-input" aria-label="Filter by status">
                            <option value="" selected="@(string.IsNullOrEmpty(statusFilter))">All Statuses</option>
                            <option value="Aanwezig" selected="@(statusFilter == "Aanwezig")">Checked In (Aanwezig)</option>
                            <option value="Openstaand" selected="@(statusFilter == "Openstaand")">Not Checked In</option>
                            <option value="Betaald" selected="@(statusFilter == "Betaald")">Paid (Betaald)</option>
                        </select>
                        <button type="submit" class="dash-action-btn">Filter</button>
                        <a asp-action="Index" class="dash-action-btn dash-action-btn--ghost">Reset</a>
                    </form>
                </div>

                <div class="table-responsive">
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th>Date &amp; Time Slot</th>
                                <th>Guest</th>
                                <th>Guests</th>
                                <th>Status</th>
                                <th>Notes</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <strong>@(item.Datum?.ToString("dd-MM-yyyy") ?? "-")</strong><br />
                                            <span class="text-muted-soft">@(item.Tijdslot?.Naam ?? $"Slot #{item.TijdSlotId}")</span>
                                        </td>
                                        <td>
                                            <strong>@(item.CustomUser?.UserName ?? item.KlantId)</strong><br />
                                            <span class="text-muted-soft">@(item.CustomUser?.Email ?? "")</span>
                                        </td>
                                        <td>@item.AantalPersonen</td>
                                        <td>
                                            @if (item.IsAanwezig)
                                            {
                                                <span class="status-badge status-seated">Checked In</span>
                                            }
                                            else if (item.Betaald)
                                            {
                                                <span class="status-badge status-confirmed">Paid</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-pending">Pending</span>
                                            }
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Opmerking) ? "-" : item.Opmerking)</td>
                                        <td class="text-end">
                                            <a asp-action="EditReservatie" asp-route-id="@item.Id" class="dash-action-btn dash-action-btn--ghost">
                                                Edit
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center panel-placeholder">No reservations match the current filter.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- PLACEHOLDER PANELS FOR OTHER OWNER MODULES -->
            <section id="panel-users" class="dash-panel">
                <div class="panel-header">
                    <div>
                        <h2>Manage Users</h2>
                        <p class="panel-subtitle">Assign roles, manage staff access, and review registered accounts.</p>
                    </div>
                </div>
                <p class="panel-placeholder">User management table and role assignment controls plug in here.</p>
            </section>

            <section id="panel-emails" class="dash-panel">
                <div class="panel-header">
                    <div>
                        <h2>Manage Emails</h2>
                        <p class="panel-subtitle">Configure post-visit questionnaires and send newsletters.</p>
                    </div>
                </div>
                <div class="subcard-grid">
                    <div class="subcard">
                        <h3>Questionnaire Emails</h3>
                        <p>Automated feedback requests and response overview.</p>
                    </div>
                    <div class="subcard">
                        <h3>Newsletter</h3>
                        <p>Seasonal announcements, menus, and subscriber lists.</p>
                    </div>
                </div>
            </section>

            <section id="panel-reports" class="dash-panel">
                <div class="panel-header">
                    <div>
                        <h2>Create Overview</h2>
                        <p class="panel-subtitle">Generate overviews across 3 report types and 3 categories.</p>
                    </div>
                </div>
                <div class="subcard-grid">
                    <div class="subcard">
                        <h3>Report Types (3)</h3>
                        <p>Summary, Trend Comparison, and Detailed Breakdown.</p>
                    </div>
                    <div class="subcard">
                        <h3>Categories (3)</h3>
                        <p>Reservations, Users &amp; Roles, and Email Engagement.</p>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.dash-nav-item').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.dash-nav-item').forEach(b => b.classList.remove('is-active'));
                document.querySelectorAll('.dash-panel').forEach(p => p.classList.remove('is-visible'));

                btn.classList.add('is-active');
                const targetId = btn.getAttribute('data-target');
                const targetPanel = document.getElementById(targetId);
                if (targetPanel) {
                    targetPanel.classList.add('is-visible');
                }
            });
        });
    </script>
}
