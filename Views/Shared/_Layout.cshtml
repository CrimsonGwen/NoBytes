<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NoBytes</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="~/Restaurant.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var isHomescreen = ViewData["IsHomescreen"] as bool? ?? false;
        var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    }

    @if (isHomescreen)
    {
        <header class="home-minimal-header">
            <a class="brand-pill" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="/Pixelkok met dampende pizza.png" class="nobytes-logo" alt="NoBytes Logo" />
                <span class="brand-pill-title">NoBytes</span>
            </a>
        </header>
    }
    else
    {
        <header class="app-header">
            <nav class="app-navbar">
                <!-- Left of logo: Home & Account -->
                <div class="nav-group-left">
                    <a class="nav-link-luxury" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    <a class="nav-link-luxury" asp-area="" asp-controller="Account" asp-action="Index">Account</a>
                </div>

                <!-- Center: Pill Brand Badge -->
                <a class="brand-pill brand-pill--compact" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="/Pixelkok met dampende pizza.png" class="nobytes-logo" alt="NoBytes Logo" />
                    <span class="brand-pill-title">NoBytes</span>
                </a>

                <!-- Right: Full navigation only once logged in -->
                <div class="nav-group-right">
                    @if (isAuthenticated)
                    {
                        <a class="nav-link-luxury" asp-controller="Owner" asp-action="Dashboard">Dashboard</a>
                        <a class="nav-link-luxury" asp-controller="Reservations" asp-action="Index">Reservations</a>
                        <a class="nav-link-luxury" asp-controller="Users" asp-action="Index">Users</a>
                        <a class="nav-link-luxury" asp-controller="Emails" asp-action="Index">Emails</a>
                        <a class="nav-link-luxury" asp-controller="Reports" asp-action="Index">Reports</a>
                    }
                    else
                    {
                        <a class="nav-link-luxury" asp-controller="LogIn" asp-action="LogIn">Login</a>
                    }
                </div>
            </nav>
        </header>
    }

    <main role="main" class="@(isHomescreen ? "p-0 m-0" : "app-main")">
        @RenderBody()
    </main>

    @if (!isHomescreen)
    {
        <footer class="custom-border-top footer">
            <div class="container">
                &copy; 2026 - NoBytes - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
