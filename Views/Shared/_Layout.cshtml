<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NoBytes</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="~/Restaurant.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var isHomescreen = ViewData["IsHomescreen"] as bool? ?? false;
        var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;

        var isOwner = isAuthenticated && User!.IsInRole("Eigenaar");
        var isManager = isAuthenticated && User!.IsInRole("Zaalverantwoordelijke");
        var isCook = isAuthenticated && User!.IsInRole("Kok");
        var isWaiter = isAuthenticated && User!.IsInRole("Ober");
        var isCustomer = isAuthenticated && User!.IsInRole("Klant");
    }

@if (isHomescreen)
    {
        <header class="home-minimal-header">
            <a class="brand-pill brand-pill--home" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="/Pixelkok met dampende pizza.png" class="nobytes-logo" alt="NoBytes Logo" />
                <span class="brand-pill-title">NoBytes</span>
            </a>
        </header>
    }
    else
    {
        <header class="app-header">
            <nav class="nav-capsule" aria-label="Primary navigation">
                <div class="nav-group-left">
                    <a class="nav-link-pill" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    <a class="nav-link-pill" asp-area="" asp-controller="Account" asp-action="Index">Account</a>
                </div>

                <a class="nav-center-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="NoBytes Home">
                    <img src="/Pixelkok met dampende pizza.png" class="nobytes-logo" alt="NoBytes Logo" />
                </a>

                <div class="nav-group-right">
                    @if (isAuthenticated)
                    {
                        @if (isOwner)
                        {
                            <a class="nav-link-pill" asp-controller="Owner" asp-action="Dashboard">Dashboard</a>
                            <a class="nav-link-pill" asp-controller="Reservations" asp-action="Index">Reservations</a>
                            <a class="nav-link-pill" asp-controller="Users" asp-action="Index">Users</a>
                            <a class="nav-link-pill" asp-controller="Emails" asp-action="Index">Emails</a>
                            <a class="nav-link-pill" asp-controller="Reports" asp-action="Index">Reports</a>
                        }
                        else if (isManager)
                        {
                            <a class="nav-link-pill" asp-controller="Manager" asp-action="Dashboard">Dashboard</a>
                            <a class="nav-link-pill" asp-controller="Reservations" asp-action="Index">Reservations</a>
                            <a class="nav-link-pill" asp-controller="Users" asp-action="Index">Users</a>
                            <a class="nav-link-pill" asp-controller="Reports" asp-action="Index">Reports</a>
                        }
                        else if (isCook)
                        {
                            <a class="nav-link-pill" asp-controller="Kitchen" asp-action="Orders">Kitchen</a>
                            <a class="nav-link-pill" asp-controller="Reservations" asp-action="FloorOverview">Covers</a>
                        }
                        else if (isWaiter)
                        {
                            <a class="nav-link-pill" asp-controller="Reservations" asp-action="Index">Reservations</a>
                            <a class="nav-link-pill" asp-controller="Kitchen" asp-action="ReadyOrders">Orders</a>
                        }
                        else if (isCustomer)
                        {
                            <a class="nav-link-pill" asp-controller="Reservations" asp-action="MyReservations">My Reservations</a>
                            <a class="nav-link-pill" asp-controller="Reservations" asp-action="Create">Book Table</a>
                        }

                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="nav-link-pill nav-btn-reset">Logout</button>
                        </form>
                    }
                </div>
            </nav>
        </header>
    }

    <main role="main" class="@(isHomescreen ? "p-0 m-0" : "app-main")">
        @RenderBody()
    </main>

    @if (!isHomescreen)
    {
        <footer class="footer">
            <div class="container">
                &copy; 2026 - NoBytes - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
